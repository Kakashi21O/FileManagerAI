# Python cache
__pycache__/
*.py[cod]

# Pytest
.pytest_cache/

# Virtual environment
.venv/
venv/
env/

# Environment variables / secrets
.env
.env.*

# Logs
logs/*
!logs/.gitkeep

# Generated reports (internal use only — never commit scan output)
reports/*
!reports/.gitkeep

# CLI output dumps — contain private file structure info, never commit these
*.ansi
report.txt
report_*.txt
report_*.ansi
output.txt
output_*.txt
scan_*.txt
plan_*.txt

# IDE
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Python packaging
*.egg-info/
dist/
build/
